local SpectateModule = {
    Active = false,
    Index = 1,
    Target = nil,
    EspEnabled = false,
    EspHighlights = {},
    Bar = nil,
    TargetLabel = nil
}

local function getAlivePlayers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            table.insert(list, p)
        end
    end
    return list
end

function SpectateModule.Cycle(dir)
    local list = getAlivePlayers()
    if #list == 0 then
        showToast("Наблюдение", "Нет игроков для наблюдения", true)
        return
    end

    SpectateModule.Index = SpectateModule.Index + dir
    if SpectateModule.Index > #list then SpectateModule.Index = 1
    elseif SpectateModule.Index < 1 then SpectateModule.Index = #list end

    local target = list[SpectateModule.Index]
    if target and target.Character and target.Character:FindFirstChild("Humanoid") then
        Camera.CameraSubject = target.Character.Humanoid
        SpectateModule.Target = target
        SpectateModule.Active = true
        if SpectateModule.Bar then SpectateModule.Bar.Visible = true end
        if SpectateModule.TargetLabel then SpectateModule.TargetLabel.Text = target.DisplayName end
    end
end

function SpectateModule.Stop()
    SpectateModule.Active = false
    if SpectateModule.Bar then SpectateModule.Bar.Visible = false end
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        Camera.CameraSubject = LocalPlayer.Character.Humanoid
    end
    showToast("Наблюдение", "Камера возвращена")
end

function SpectateModule.Teleport()
    local target = SpectateModule.Target
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") and myRoot then
        myRoot.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
        showToast("Телепорт", "Телепортирован к " .. target.DisplayName)
    else
        showToast("Телепорт", "Цель недоступна", true)
    end
end

function SpectateModule.ToggleEsp()
    SpectateModule.EspEnabled = not SpectateModule.EspEnabled
    if not SpectateModule.EspEnabled then
        for _, h in pairs(SpectateModule.EspHighlights) do if h and h.Parent then h:Destroy() end end
        table.clear(SpectateModule.EspHighlights)
        showToast("ESP Игроков", "ESP отключен")
    else
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local h = Instance.new("Highlight")
                h.FillTransparency = 1
                h.OutlineColor = Color3.fromRGB(255, 255, 255)
                h.OutlineTransparency = 0.1
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Adornee = p.Character
                h.Parent = p.Character
                SpectateModule.EspHighlights[p] = h
            end
        end
        showToast("ESP Игроков", "ESP всех игроков включен")
    end
end

