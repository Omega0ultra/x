local Telekinesis = {
    Holding = false,
    Dist = 15
}

function Telekinesis.GiveTool()
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:WaitForChild("Backpack")
    local old = bp:FindFirstChild("Телекинез") or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Телекинез"))
    if old then old:Destroy() end

    local tool = Instance.new("Tool")
    tool.Name = "Телекинез"
    tool.RequiresHandle = true
    tool.CanBeDropped = false

    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(0.6, 0.6, 0.6)
    handle.Transparency = 0.5
    handle.Material = Enum.Material.Neon
    handle.Color = T.Accent
    handle.CanCollide = false
    handle.Parent = tool

    local selectionBox = Instance.new("SelectionBox")
    selectionBox.LineThickness = 0.05
    selectionBox.Color3 = T.Accent
    selectionBox.Parent = tool

    local laser = Instance.new("Part")
    laser.Name = "Laser"
    laser.Anchored = true
    laser.CanCollide = false
    laser.CastShadow = false
    laser.Material = Enum.Material.Neon
    laser.Color = T.Accent
    laser.Transparency = 0.3
    laser.Size = Vector3.new(0.15, 0.15, 1)

    local targetObj = nil
    local bpPhysics = nil
    local renderConn = nil

    tool.Equipped:Connect(function(mouse)
        mouse.Icon = "rbxasset://textures/GunCursor.png"

        mouse.Button1Down:Connect(function()
            if Telekinesis.Holding then return end
            Telekinesis.Holding = true

            local t = mouse.Target
            if t and not t.Anchored and t.Parent ~= LocalPlayer.Character then
                targetObj = t
                selectionBox.Adornee = targetObj
                Telekinesis.Dist = math.clamp((targetObj.Position - handle.Position).Magnitude, 5, 200)

                bpPhysics = Instance.new("BodyPosition")
                bpPhysics.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bpPhysics.P = 30000
                bpPhysics.D = 500
                bpPhysics.Position = targetObj.Position
                bpPhysics.Parent = targetObj
            end

            laser.Parent = Workspace

            renderConn = RunService.RenderStepped:Connect(function()
                if not Telekinesis.Holding or not handle.Parent then
                    if renderConn then renderConn:Disconnect(); renderConn = nil end
                    laser.Parent = nil
                    return
                end

                local startP = handle.Position
                local endP = mouse.Hit.Position
                if targetObj and targetObj.Parent then
                    local ray = mouse.UnitRay
                    local goal = Camera.CFrame.Position + ray.Direction * Telekinesis.Dist
                    if bpPhysics and bpPhysics.Parent then bpPhysics.Position = goal end
                    endP = targetObj.Position
                end

                local len = (startP - endP).Magnitude
                laser.Size = Vector3.new(0.15, 0.15, len)
                laser.CFrame = CFrame.new(startP, endP) * CFrame.new(0, 0, -len / 2)
            end)
        end)

        mouse.Button1Up:Connect(function()
            Telekinesis.Holding = false
            if renderConn then renderConn:Disconnect(); renderConn = nil end
            laser.Parent = nil
            if bpPhysics then bpPhysics:Destroy(); bpPhysics = nil end
            selectionBox.Adornee = nil
            targetObj = nil
        end)

        mouse.KeyDown:Connect(function(k)
            k = k:lower()
            if k == "q" then Telekinesis.Dist = math.max(5, Telekinesis.Dist - 5)
            elseif k == "e" then Telekinesis.Dist = Telekinesis.Dist + 5
            elseif k == "u" and targetObj then
                local bg = Instance.new("BodyGyro")
                bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                bg.CFrame = targetObj.CFrame * CFrame.Angles(0, math.rad(45), 0)
                bg.Parent = targetObj
                task.delay(0.5, function() bg:Destroy() end)
            elseif k == "p" and targetObj then
                local bv = Instance.new("BodyVelocity")
                bv.MaxForce = Vector3.new(0, math.huge, 0)
                bv.Velocity = Vector3.new(0, 60, 0)
                bv.Parent = targetObj
                task.delay(0.3, function() bv:Destroy() end)
            elseif k == "l" and targetObj then
                targetObj.Velocity = Vector3.new(0, 0, 0)
                targetObj.RotVelocity = Vector3.new(0, 0, 0)
            elseif k == "y" then Telekinesis.Dist = 100
            elseif k == "j" then Telekinesis.Dist = 5000
            elseif k == "x" then Telekinesis.Dist = 15 end
        end)
    end)

    tool.Unequipped:Connect(function()
        Telekinesis.Holding = false
        if renderConn then renderConn:Disconnect(); renderConn = nil end
        laser.Parent = nil
        if bpPhysics then bpPhysics:Destroy(); bpPhysics = nil end
        selectionBox.Adornee = nil
        targetObj = nil
    end)

    tool.Parent = bp
    showToast("Телекинез", "Инструмент добавлен в инвентарь! (Q/E - дист, J - бросок)")
end

