    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextColor3 = T.PillText
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Text = labelText
    label.ZIndex = 104
    label.Parent = pill

    -- Анимация микро-взаимодействия при нажатии
    pill.MouseButton1Down:Connect(function()
        tween(pill, 0.08, {Size = UDim2.new(0, 160, 0, 40)})
    end)
    pill.MouseButton1Up:Connect(function()
        tween(pill, 0.1, {Size = UDim2.new(0, 165, 0, 42)})
    end)
    pill.MouseButton1Click:Connect(onClick)

    table.insert(ThemeRegistry.Pills, {Pill = pill, Icon = icon, Label = label})
    return pill
end

