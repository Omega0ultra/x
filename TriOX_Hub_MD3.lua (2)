-- 11. ПЕРЕКРАШИВАНИЕ ТЕМЫ (ДИНАМИЧЕСКИЙ RECOLOR)
-- ══════════════════════════════════════════════════════════════════════

local function applyTheme(key)
    themeKey = key
    T = Themes[themeKey]

    -- FAB closed
    if ThemeRegistry.FabClosed then
        ThemeRegistry.FabClosed.BackgroundColor3 = T.FabBg
        ThemeRegistry.FabClosedIcon.ImageColor3 = T.FabIcon
    end

    -- FAB opened
    if ThemeRegistry.FabOpened then
        ThemeRegistry.FabOpened.BackgroundColor3 = T.CloseFabBg
        ThemeRegistry.FabOpenedIcon.ImageColor3 = T.CloseFabIcon
    end

    -- Pills
    for _, item in ipairs(ThemeRegistry.Pills) do
        item.Pill.BackgroundColor3 = T.PillBg
        item.Icon.ImageColor3 = T.PillText
        item.Label.TextColor3 = T.PillText
    end

    -- Panels
    for _, p in ipairs(ThemeRegistry.Panels) do
        p.Panel.BackgroundColor3 = T.CardBg
        p.Header.BackgroundColor3 = T.CardHeader
        p.Cover.BackgroundColor3 = T.CardHeader
        p.Stroke.Color = T.CardStroke
        p.Icon.ImageColor3 = T.Accent
        p.Title.TextColor3 = T.CardText
        p.Close.BackgroundColor3 = T.ButtonSecondary
        p.Close.ImageColor3 = T.CardText
    end

    -- Buttons
    for _, bData in ipairs(ThemeRegistry.Buttons) do
        if bData.Role == "Primary" then
            bData.Button.BackgroundColor3 = T.ButtonPrimary
            bData.Button.TextColor3 = T.ButtonPrimaryText
        elseif bData.Role == "Secondary" then
            bData.Button.BackgroundColor3 = T.ButtonSecondary
            bData.Button.TextColor3 = T.CardText
        end
    end

    -- Inputs
    for _, tb in ipairs(ThemeRegistry.Inputs) do
        tb.BackgroundColor3 = T.InputBg
        tb.TextColor3 = T.CardText
        tb.PlaceholderColor3 = T.CardTextSub
    end

    showToast("Тема", "Применена тема: " .. T.Name)
end

