    Color = Color3.fromRGB(80, 220, 160),
    ShowName = true,
    ShowDist = true,
    Highlights = {},
    Billboards = {},
    Heartbeat = nil
}

function EspModule.Clear()
    if EspModule.Heartbeat then
        EspModule.Heartbeat:Disconnect()
        EspModule.Heartbeat = nil
    end
    for _, h in pairs(EspModule.Highlights) do if h and h.Parent then h:Destroy() end end
    table.clear(EspModule.Highlights)
    for _, b in pairs(EspModule.Billboards) do if b and b.Parent then b:Destroy() end end
    table.clear(EspModule.Billboards)
end

function EspModule.Apply()
    EspModule.Clear()
    local targets = {}
    local q = string.lower(EspModule.Query)

    if q == "players" or q == "игроки" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local root = p.Character:FindFirstChild("HumanoidRootPart") or p.Character:FindFirstChildWhichIsA("BasePart")
                if root then table.insert(targets, {Part = root, Name = p.DisplayName}) end
            end
        end
    elseif q == "tools" or q == "предметы" then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
                table.insert(targets, {Part = obj.Handle, Name = obj.Name})
            end
        end
    else
        local found = Workspace:FindFirstChild(EspModule.Query)
        if found then
            for _, d in ipairs(found:GetDescendants()) do
                if d:IsA("BasePart") then table.insert(targets, {Part = d, Name = d.Name}) end
            end
            if found:IsA("BasePart") then table.insert(targets, {Part = found, Name = found.Name}) end
        else
            for _, d in ipairs(Workspace:GetDescendants()) do
                if d:IsA("BasePart") and string.find(string.lower(d.Name), q, 1, true) then
                    table.insert(targets, {Part = d, Name = d.Name})
                end
            end
        end
    end

    if #targets == 0 then
        showToast("Подсветка", "Объекты не найдены: '" .. EspModule.Query .. "'", true)
        return
    end

    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    for _, entry in ipairs(targets) do
        local part = entry.Part
        local h = Instance.new("Highlight")
        h.FillColor = EspModule.Color
        h.OutlineColor = EspModule.Color
        h.FillTransparency = 0.5
        h.OutlineTransparency = 0
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Adornee = part
        h.Parent = part
        table.insert(EspModule.Highlights, h)

        if EspModule.ShowName or EspModule.ShowDist then
            local bb = Instance.new("BillboardGui")
            bb.Adornee = part
            bb.Size = UDim2.new(0, 140, 0, 32)
            bb.StudsOffset = Vector3.new(0, 3, 0)
            bb.AlwaysOnTop = true
            bb.MaxDistance = 500

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.Font = Enum.Font.GothamBold
            lbl.TextSize = 11
            lbl.TextColor3 = Color3.new(1, 1, 1)
            lbl.TextStrokeTransparency = 0.4

            local d = myRoot and (myRoot.Position - part.Position).Magnitude or 0
            local txt = entry.Name
            if EspModule.ShowName and EspModule.ShowDist then txt = string.format("%s\n[%.0f studs]", entry.Name, d)
            elseif EspModule.ShowDist then txt = string.format("[%.0f studs]", d) end
            lbl.Text = txt
            lbl.Parent = bb
            bb.Parent = part
            table.insert(EspModule.Billboards, {Billboard = bb, Label = lbl, Part = part, Name = entry.Name})
        end
    end

    showToast("Подсветка", "Подсвечено объектов: " .. #targets)

    EspModule.Heartbeat = RunService.Heartbeat:Connect(function()
        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not root then return end

        for i = #EspModule.Billboards, 1, -1 do
            local item = EspModule.Billboards[i]
            if item.Part and item.Part.Parent then
                local dist = (root.Position - item.Part.Position).Magnitude
                local txt = item.Name
                if EspModule.ShowName and EspModule.ShowDist then txt = string.format("%s\n[%.0f studs]", item.Name, dist)
                elseif EspModule.ShowDist then txt = string.format("[%.0f studs]", dist) end
                item.Label.Text = txt
            else
                if item.Billboard and item.Billboard.Parent then item.Billboard:Destroy() end
                table.remove(EspModule.Billboards, i)
            end
        end
    end)
end

