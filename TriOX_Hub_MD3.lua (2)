function UtilsModule.ToggleNoclip(en)
    if en then
        UtilsModule.NoclipConn = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then
                for _, p in ipairs(LocalPlayer.Character:GetDescendants()) do
                    if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
                end
            end
        end)
        showToast("Утилиты", "Noclip включен")
    else
        if UtilsModule.NoclipConn then UtilsModule.NoclipConn:Disconnect(); UtilsModule.NoclipConn = nil end
        showToast("Утилиты", "Noclip выключен")
    end
end

function UtilsModule.ToggleInfJump(en)
    if en then
        UtilsModule.InfJumpConn = UserInputService.JumpRequest:Connect(function()
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end)
        showToast("Утилиты", "Infinite Jump включен")
    else
        if UtilsModule.InfJumpConn then UtilsModule.InfJumpConn:Disconnect(); UtilsModule.InfJumpConn = nil end
        showToast("Утилиты", "Infinite Jump выключен")
    end
end

function UtilsModule.ToggleFullbright(en)
    if en then
        UtilsModule.FullbrightConn = RunService.RenderStepped:Connect(function()
            Lighting.Ambient = Color3.fromRGB(255, 255, 255)
            Lighting.Brightness = 2
            Lighting.ClockTime = 14
            Lighting.FogEnd = 1e6
            Lighting.GlobalShadows = false
        end)
        showToast("Утилиты", "Fullbright включен")
    else
        if UtilsModule.FullbrightConn then UtilsModule.FullbrightConn:Disconnect(); UtilsModule.FullbrightConn = nil end
        Lighting.Ambient = UtilsModule.OrigAmbient
        Lighting.Brightness = UtilsModule.OrigBrightness
        Lighting.ClockTime = UtilsModule.OrigClock
        Lighting.GlobalShadows = true
        showToast("Утилиты", "Fullbright выключен")
    end
end

function UtilsModule.GiveBTools()
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:WaitForChild("Backpack")
    local tools = {
        {Name = "Move Tool", Id = 1},
        {Name = "Delete Tool", Id = 2},
        {Name = "Copy Tool", Id = 3},
        {Name = "Resize Tool", Id = 4}
    }
    for _, t in ipairs(tools) do
        local hopper = Instance.new("HopperBin")
        hopper.BinType = t.Id
        hopper.Name = t.Name
        hopper.Parent = bp
    end
    showToast("Утилиты", "BTools добавлены в инвентарь!")
end

function UtilsModule.Rejoin()
    showToast("Сервер", "Перезаход на сервер...")
    if #Players:GetPlayers() <= 1 then
        LocalPlayer:Kick("\nПереподключение...")
        task.wait(0.5)
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    else
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
    end
end

