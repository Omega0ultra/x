    btn.AutoButtonColor = false
    btn.Parent = parent

    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 10); c.Parent = btn

    local img = Instance.new("ImageLabel")
    img.Size = UDim2.new(0, 16, 0, 16)
    img.Position = UDim2.new(0, 10, 0.5, -8)
    img.BackgroundTransparency = 1
    local textColor = (role == "Primary") and T.ButtonPrimaryText or ((role == "Danger") and T.ButtonDangerText or T.ButtonSecondaryText)
    setIcon(img, iconData, textColor)
    img.Active = false
    img.Parent = btn

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -34, 1, 0)
    lbl.Position = UDim2.new(0, 30, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 11
    lbl.TextColor3 = textColor
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextTruncate = Enum.TextTruncate.AtEnd
    lbl.Text = textStr
    lbl.Active = false
    lbl.Parent = btn

    table.insert(ThemeRegistry.Buttons, {
        Button = btn,
        Role = role or "Secondary",
        IconImg = img,
        TextLbl = lbl
    })

    setupTouchButton(btn, onClick, hapticStyle or "tap")
    return btn, lbl, img
end

