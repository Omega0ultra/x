-- 10. УМНЫЙ МОДУЛЬ ПОДСВЕТКИ (ESP / HIGHLIGHT)
-- ══════════════════════════════════════════════════════════════════════
-- Полноценная поддержка:
--  - Модели (Model) с поиском опорной части (PrimaryPart, HRP, Torso, Head)
--  - Объекты, содержащие невидимые элементы/хитбоксы (Transparency >= 0.95, CanCollide = false)
--  - Нечёткий поиск (fuzzy matching): опечатки, похожие названия, аббревиатуры, токены
--  - Поддержка русского языка (Cyrillic toLower & normalize)
--  - 3D Highlight силуэты через стены + информационные BillboardGui плашки с дистанцией

local function toLowerUtf8(s)
    if not s then return "" end
    local t = {}
    local i = 1
    local len = #s
    while i <= len do
        local b1 = s:byte(i)
        if b1 >= 65 and b1 <= 90 then
            table.insert(t, string.char(b1 + 32))
            i = i + 1
        elseif b1 == 208 and i < len then
            local b2 = s:byte(i + 1)
            if b2 == 129 then
                table.insert(t, string.char(209, 145))
            elseif b2 >= 144 and b2 <= 159 then
                table.insert(t, string.char(208, b2 + 32))
            elseif b2 >= 160 and b2 <= 175 then
                table.insert(t, string.char(209, b2 - 32))
            else
                table.insert(t, string.char(b1, b2))
            end
            i = i + 2
        else
            table.insert(t, string.char(b1))
            i = i + 1
        end
    end
    return table.concat(t)
end

local function normalizeStr(s)
    if not s then return "" end
    local lower = toLowerUtf8(s)
    return (lower:gsub("[%s%-_%p]+", ""))
end

local function toCodepoints(s)
    local t = {}
    local i = 1
    local len = #s
    while i <= len do
        local b1 = s:byte(i)
        if b1 < 128 then
            table.insert(t, b1)
            i = i + 1
        elseif b1 >= 192 and b1 < 224 and i < len then
            table.insert(t, b1 * 256 + s:byte(i + 1))
            i = i + 2
        elseif b1 >= 224 and b1 < 240 and i + 1 < len then
            table.insert(t, (b1 * 256 + s:byte(i + 1)) * 256 + s:byte(i + 2))
            i = i + 3
        else
            table.insert(t, b1)
            i = i + 1
        end
    end
    return t
end

local function levenshteinUtf8(cp1, cp2)
    local len1, len2 = #cp1, #cp2
    if len1 == 0 then return len2 end
    if len2 == 0 then return len1 end
    local prev = {}
    for j = 0, len2 do prev[j] = j end
    for i = 1, len1 do
        local curr = {[0] = i}
        local c1 = cp1[i]
        for j = 1, len2 do
            local cost = (c1 == cp2[j]) and 0 or 1
            curr[j] = math.min(
                prev[j] + 1,
                curr[j - 1] + 1,
                prev[j - 1] + cost
            )
        end
        prev = curr
    end
    return prev[len2]
end

local function isFuzzyMatch(name, queryRaw)
    if not name or name == "" or not queryRaw or queryRaw == "" then return false end
    local nameLower = toLowerUtf8(name)
    local qLower = toLowerUtf8(queryRaw:gsub("^%s+", ""):gsub("%s+$", ""))
    if qLower == "" then return false end

    -- 1. Точное совпадение
    if nameLower == qLower then return true end

    -- 2. Вхождение подстроки (plain text, без поломок от спецсимволов regex)
    if string.find(nameLower, qLower, 1, true) then return true end

    -- 3. Нормализованный поиск (игнорирует пробелы, тире, подчёркивания и знаки)
    local normName = normalizeStr(nameLower)
    local normQ = normalizeStr(qLower)
    if normQ ~= "" and string.find(normName, normQ, 1, true) then return true end

    -- 4. Поиск по нескольким словам (все токены запроса должны присутствовать)
    local words = {}
    for w in qLower:gmatch("%S+") do table.insert(words, w) end
    if #words > 1 then
        local allFound = true
        for _, w in ipairs(words) do
            local nw = normalizeStr(w)
            if not string.find(nameLower, w, 1, true) and not string.find(normName, nw, 1, true) then
                allFound = false
                break
            end
        end
        if allFound then return true end
    end

    -- 5. Аббревиатура / подпоследовательность символов (например hrp -> HumanoidRootPart)
    local cpName = toCodepoints(normName)
    local cpQ = toCodepoints(normQ)
    if #cpQ >= 2 and #cpQ <= 8 and #cpName >= #cpQ then
        local qIdx = 1
        local qLen = #cpQ
        for i = 1, #cpName do
            if cpName[i] == cpQ[qIdx] then
                qIdx = qIdx + 1
                if qIdx > qLen then return true end
            end
        end
    end

    -- 6. Опечатки и похожие названия (Levenshtein distance для отдельных слов и префикса)
    if #cpQ >= 3 then
        local maxAllowed = (#cpQ <= 5) and 1 or 2

        -- Проверка по каждому отдельному слову в целевом имени
        local cleaned = nameLower:gsub("[%p%s%-_]+", " ")
        for word in cleaned:gmatch("%S+") do
            local cpWord = toCodepoints(word)
            if #cpWord >= 3 and math.abs(#cpWord - #cpQ) <= maxAllowed then
                if levenshteinUtf8(cpQ, cpWord) <= maxAllowed then
                    return true
                end
            end
        end

        -- Проверка префикса нормализованного имени
        if #cpName >= 3 then
            local prefixCp = {}
            for i = 1, math.min(#cpName, #cpQ + 2) do table.insert(prefixCp, cpName[i]) end
            if math.abs(#prefixCp - #cpQ) <= maxAllowed and levenshteinUtf8(cpQ, prefixCp) <= maxAllowed then
                return true
            end
        end
    end

    return false
end

local function getRepresentativePart(instance)
    if not instance then return nil end
    if instance:IsA("BasePart") then
        return instance
    elseif instance:IsA("Model") then
        if instance.PrimaryPart and instance.PrimaryPart:IsA("BasePart") then
            return instance.PrimaryPart
        end
        local hrp = instance:FindFirstChild("HumanoidRootPart")
        if hrp and hrp:IsA("BasePart") then return hrp end
        local torso = instance:FindFirstChild("Torso") or instance:FindFirstChild("UpperTorso")
        if torso and torso:IsA("BasePart") then return torso end
        local head = instance:FindFirstChild("Head")
        if head and head:IsA("BasePart") then return head end
        local anyPart = instance:FindFirstChildWhichIsA("BasePart", true)
        if anyPart then return anyPart end
    end
    return nil
end

local EspModule = {
    Active = false,
    Billboards = {},
    Highlights = {},
    Query = "Players",
    Heartbeat = nil,
    InputBox = nil
}

function EspModule.Clear()
    EspModule.Active = false
    hapticFeedback("danger")
    if EspModule.Heartbeat then EspModule.Heartbeat:Disconnect(); EspModule.Heartbeat = nil end
    for _, item in ipairs(EspModule.Billboards) do
        if item.Billboard and item.Billboard.Parent then item.Billboard:Destroy() end
    end
    table.clear(EspModule.Billboards)
    for _, hl in ipairs(EspModule.Highlights) do
        if hl and hl.Parent then hl:Destroy() end
    end
    table.clear(EspModule.Highlights)
end

function EspModule.Apply()
    EspModule.Clear()
    EspModule.Active = true

    if EspModule.InputBox and EspModule.InputBox.Parent and EspModule.InputBox.Text then
        EspModule.Query = EspModule.InputBox.Text
    end

    local rawQuery = EspModule.Query or ""
    local qTrimmed = rawQuery:gsub("^%s+", ""):gsub("%s+$", "")
    local qNorm = normalizeStr(qTrimmed)

    local targets = {}
    local seenInstances = {}
    local maxTargets = 120

    local function isIgnored(inst)
        if not inst then return true end
        if inst == Workspace or inst == Camera or inst == Terrain then return true end
        local myChar = LocalPlayer.Character
        if myChar and (inst == myChar or inst:IsDescendantOf(myChar)) then return true end
        if inst:IsDescendantOf(Camera) or inst:IsDescendantOf(guiContainer) then return true end
        return false
    end

    if qNorm == "players" or qNorm == "player" or qNorm == "plrs" or qNorm == "plr"
        or qNorm == "игроки" or qNorm == "игрок" or qNorm == "челы" or qNorm == "люди" or qNorm == "" then
        -- 1. ИГРОКИ (PLAYERS)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local char = p.Character
                local root = getRepresentativePart(char)
                if root then
                    table.insert(targets, {
                        Instance = char,
                        Part = root,
                        Name = p.DisplayName .. " (@" .. p.Name .. ")",
                        Color = Color3.fromRGB(120, 215, 255)
                    })
                end
            end
        end

    elseif qNorm == "tools" or qNorm == "tool" or qNorm == "items" or qNorm == "item"
        or qNorm == "вещи" or qNorm == "предметы" or qNorm == "оружие" or qNorm == "дроп" then
        -- 2. ПРЕДМЕТЫ / ОРУЖИЕ В WORKSPACE
        for _, inst in ipairs(Workspace:GetDescendants()) do
            if not isIgnored(inst) and inst:IsA("Tool") then
                local handle = inst:FindFirstChild("Handle") or getRepresentativePart(inst)
                if handle and not seenInstances[inst] then
                    seenInstances[inst] = true
                    table.insert(targets, {
                        Instance = inst,
                        Part = handle,
                        Name = inst.Name,
                        Color = Color3.fromRGB(255, 215, 100)
                    })
                    if #targets >= maxTargets then break end
                end
            end
        end

    elseif qNorm == "npcs" or qNorm == "npc" or qNorm == "мобы" or qNorm == "моб"
        or qNorm == "нпс" or qNorm == "боссы" or qNorm == "босс" or qNorm == "враги" then
        -- 3. МОБЫ / NPC С HUMANOID
        for _, inst in ipairs(Workspace:GetDescendants()) do
            if not isIgnored(inst) and inst:IsA("Model") and inst:FindFirstChildOfClass("Humanoid") then
                if not Players:GetPlayerFromCharacter(inst) and not seenInstances[inst] then
                    local root = getRepresentativePart(inst)
                    if root then
                        seenInstances[inst] = true
                        table.insert(targets, {
                            Instance = inst,
                            Part = root,
                            Name = inst.Name,
                            Color = Color3.fromRGB(255, 120, 100)
                        })
                        if #targets >= maxTargets then break end
                    end
                end
            end
        end

    elseif qNorm == "spawns" or qNorm == "spawn" or qNorm == "спавн" or qNorm == "спавны" then
        -- 4. ТОЧКИ СПАВНА
        for _, inst in ipairs(Workspace:GetDescendants()) do
            if not isIgnored(inst) and (inst:IsA("SpawnLocation") or isFuzzyMatch(inst.Name, "spawn")) then
                local rep = getRepresentativePart(inst)
                if rep and not seenInstances[inst] then
                    seenInstances[inst] = true
                    table.insert(targets, {
                        Instance = inst,
                        Part = rep,
                        Name = inst.Name,
                        Color = Color3.fromRGB(100, 255, 150)
                    })
                    if #targets >= maxTargets then break end
                end
            end
        end

    else
        -- 5. ПОЛНОЦЕННЫЙ ПОИСК МОДЕЛЕЙ, НЕВИДИМЫХ ХИТБОКСОВ И ПОХОЖИХ ИМЕН
        for _, inst in ipairs(Workspace:GetDescendants()) do
            if #targets >= maxTargets then break end
            if not isIgnored(inst) then
                -- А) Сама сущность — Model с подходящим/похожим именем
                if inst:IsA("Model") then
                    if isFuzzyMatch(inst.Name, qTrimmed) then
                        if not seenInstances[inst] then
                            local rep = getRepresentativePart(inst)
                            if rep then
                                seenInstances[inst] = true
                                table.insert(targets, {
                                    Instance = inst,
                                    Part = rep,
                                    Name = inst.Name,
                                    Color = Color3.fromRGB(200, 160, 255)
                                })
                            end
                        end
                    end

                -- Б) Сущность — BasePart (включая невидимые хитбоксы, Transparency >= 0.95, CanCollide = false)
                elseif inst:IsA("BasePart") then
                    if isFuzzyMatch(inst.Name, qTrimmed) then
                        local parentModel = inst:FindFirstAncestorWhichIsA("Model")
                        if parentModel and parentModel ~= Workspace and not Players:GetPlayerFromCharacter(parentModel) then
                            -- Модель, содержащая этот (в т.ч. невидимый) элемент
                            if not seenInstances[parentModel] then
                                seenInstances[parentModel] = true
                                local isInv = (inst.Transparency >= 0.95 or not inst.CanCollide)
                                local dName = (parentModel.Name == inst.Name)
                                    and inst.Name
                                    or (parentModel.Name .. " (" .. inst.Name .. ")")
                                table.insert(targets, {
                                    Instance = parentModel,
                                    Part = inst,
                                    Name = dName,
                                    Color = isInv and Color3.fromRGB(130, 230, 210) or Color3.fromRGB(200, 160, 255)
                                })
                            end
                        else
                            -- Отдельная деталь (видимая или невидимая)
                            if not seenInstances[inst] then
                                seenInstances[inst] = true
                                local isInv = (inst.Transparency >= 0.95 or not inst.CanCollide)
                                table.insert(targets, {
                                    Instance = inst,
                                    Part = inst,
                                    Name = inst.Name,
                                    Color = isInv and Color3.fromRGB(130, 230, 210) or Color3.fromRGB(200, 160, 255)
                                })
                            end
                        end
                    end

                -- В) Интерактивные триггеры, подсказки, аттачменты, значения с нужным именем
                elseif inst:IsA("ProximityPrompt") or inst:IsA("Attachment") or inst:IsA("ClickDetector") or inst:IsA("ValueBase") then
                    if isFuzzyMatch(inst.Name, qTrimmed) then
                        local parentModel = inst:FindFirstAncestorWhichIsA("Model")
                        local parentPart = inst:FindFirstAncestorWhichIsA("BasePart") or (parentModel and getRepresentativePart(parentModel))
                        if parentPart then
                            local owner = (parentModel and parentModel ~= Workspace) and parentModel or parentPart
                            if not seenInstances[owner] then
                                seenInstances[owner] = true
                                local dName = owner.Name .. " (" .. inst.Name .. ")"
                                table.insert(targets, {
                                    Instance = owner,
                                    Part = parentPart,
                                    Name = dName,
                                    Color = Color3.fromRGB(130, 230, 210)
                                })
                            end
                        end
                    end
                end
            end
        end
    end

    if #targets == 0 then
        hapticFeedback("danger")
        showToast("Подсветка", "Ничего не найдено", true)
        return
    end

    hapticFeedback("toggle_on")

    -- Сортировка целей по расстоянию от игрока (ближайшие подсвечиваются первыми)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Torso"))
    local myPos = myRoot and myRoot.Position or Vector3.new(0, 0, 0)
    table.sort(targets, function(a, b)
        local distA = (a.Part.Position - myPos).Magnitude
        local distB = (b.Part.Position - myPos).Magnitude
        return distA < distB
    end)

    -- Создание 3D Highlight + информационных меток BillboardGui
    for i, t in ipairs(targets) do
        -- 3D объемная подсветка через стены (до 31 в соответствии с лимитом движка Roblox)
        if i <= 31 and t.Instance then
            pcall(function()
                local hl = Instance.new("Highlight")
                hl.Name = "TriOX_Highlight"
                hl.FillColor = t.Color
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.FillTransparency = 0.55
                hl.OutlineTransparency = 0.1
