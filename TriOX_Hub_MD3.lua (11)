local function createM3Switch(parent, initialOn, isLocked, onToggle)
    local switchBtn = Instance.new("TextButton")
    switchBtn.Name = "M3Switch"
    switchBtn.Size = UDim2.new(0, 48, 0, 26)
    switchBtn.Position = UDim2.new(1, -54, 0.5, -13)
    switchBtn.BorderSizePixel = 0
    switchBtn.AutoButtonColor = false
    switchBtn.Text = ""
    switchBtn.Parent = parent

    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(1, 0)
    trackCorner.Parent = switchBtn

    local trackStroke = Instance.new("UIStroke")
    trackStroke.Thickness = 1.5
    trackStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    trackStroke.Parent = switchBtn

    local thumb = Instance.new("Frame")
    thumb.Name = "Thumb"
    thumb.Size = UDim2.new(0, 20, 0, 20)
    thumb.BorderSizePixel = 0
    thumb.Parent = switchBtn

    local thumbCorner = Instance.new("UICorner")
    thumbCorner.CornerRadius = UDim.new(1, 0)
    thumbCorner.Parent = thumb

    local thumbIcon = Instance.new("ImageLabel")
    thumbIcon.Name = "Icon"
    thumbIcon.Size = UDim2.new(0, 12, 0, 12)
    thumbIcon.Position = UDim2.new(0.5, -6, 0.5, -6)
    thumbIcon.BackgroundTransparency = 1
    thumbIcon.Active = false
    thumbIcon.Parent = thumb

    local state = initialOn and true or false

    local function getColors()
        local trackOffBg = isDarkMode and Color3.fromHSV(currentHue, 0.20, 0.16) or Color3.fromRGB(230, 226, 235)
        local strokeOffColor = isDarkMode and Color3.fromHSV(currentHue, 0.20, 0.45) or Color3.fromRGB(160, 155, 170)
        local thumbOffBg = strokeOffColor
        local iconOffColor = trackOffBg

        local trackOnBg = T.ButtonPrimary
        local thumbOnBg = isDarkMode and Color3.fromHSV(currentHue, 0.85, 0.18) or Color3.fromRGB(255, 255, 255)
        local iconOnColor = T.ButtonPrimary

        return trackOffBg, strokeOffColor, thumbOffBg, iconOffColor, trackOnBg, thumbOnBg, iconOnColor
    end

    local function applyVisuals(animate)
        local dur = animate and 0.18 or 0
        local trackOffBg, strokeOffColor, thumbOffBg, iconOffColor, trackOnBg, thumbOnBg, iconOnColor = getColors()

        if state then
            -- ON STATE (Screenshot_20261011-134250.png)
            if animate then
                tweenProp(switchBtn, dur, {BackgroundColor3 = trackOnBg})
                tweenProp(trackStroke, dur, {Transparency = 1.0, Color = trackOnBg})
                tweenProp(thumb, dur, {
                    Position = UDim2.new(1, -23, 0.5, -10),
                    BackgroundColor3 = thumbOnBg
                })
                tweenProp(thumbIcon, dur, {ImageColor3 = iconOnColor})
            else
                switchBtn.BackgroundColor3 = trackOnBg
                trackStroke.Transparency = 1.0
                trackStroke.Color = trackOnBg
                thumb.Position = UDim2.new(1, -23, 0.5, -10)
                thumb.BackgroundColor3 = thumbOnBg
                thumbIcon.ImageColor3 = iconOnColor
            end
            setIcon(thumbIcon, Icons.Check, iconOnColor)
        else
            -- OFF STATE (Screenshot_20261011-134312.png)
            if animate then
                tweenProp(switchBtn, dur, {BackgroundColor3 = trackOffBg})
                tweenProp(trackStroke, dur, {Transparency = 0.0, Color = strokeOffColor})
                tweenProp(thumb, dur, {
                    Position = UDim2.new(0, 3, 0.5, -10),
                    BackgroundColor3 = thumbOffBg
                })
                tweenProp(thumbIcon, dur, {ImageColor3 = iconOffColor})
            else
                switchBtn.BackgroundColor3 = trackOffBg
                trackStroke.Transparency = 0.0
                trackStroke.Color = strokeOffColor
                thumb.Position = UDim2.new(0, 3, 0.5, -10)
                thumb.BackgroundColor3 = thumbOffBg
                thumbIcon.ImageColor3 = iconOffColor
            end
            setIcon(thumbIcon, Icons.Close, iconOffColor)
        end
    end

    applyVisuals(false)

    local switchObj = {
        Button = switchBtn,
        Thumb = thumb,
        TrackStroke = trackStroke,
        Icon = thumbIcon,
        GetState = function() return state end,
        SetState = function(newState, anim)
            state = newState
            applyVisuals(anim)
        end,
        UpdateTheme = function()
            applyVisuals(true)
        end
    }
    table.insert(ActiveSwitches, switchObj)

    setupTouchButton(switchBtn, function()
        if isLocked then
            hapticFeedback("tick")
            showToast("Настройки", "Кнопка зафиксирована в меню")
            return
        end
        state = not state
        hapticFeedback(state and "toggle_on" or "toggle_off")
        applyVisuals(true)
        if onToggle then onToggle(state) end
    end, "tap")

    return switchObj
end
