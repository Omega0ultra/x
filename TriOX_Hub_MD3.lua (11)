    lbl.Active = false
    lbl.Parent = b

    local conn = nil
    local tickCounter = 0
    local function cancel()
        if conn then conn:Disconnect(); conn = nil end
    end

    b.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            hapticFeedback("tap")
            tween(b, 0.08, {Size = UDim2.new(size.X.Scale, size.X.Offset - 2, size.Y.Scale, size.Y.Offset - 2)})
            if FlyModule.Active then
                cancel()
                tickCounter = 0
                conn = RunService.Heartbeat:Connect(function()
                    local chr = LocalPlayer.Character
                    local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.CFrame = hrp.CFrame * CFrame.new(0, factor * FlyModule.Speed, 0)
                    end
                    tickCounter = tickCounter + 1
                    if tickCounter % 15 == 0 then
                        hapticFeedback("tick")
                    end
                end)
            end
        end
    end)

    b.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            cancel()
            tween(b, 0.12, {Size = size}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        end
    end)

    table.insert(ThemeRegistry.Buttons, {Button = b, Role = "Secondary", IconImg = img, TextLbl = lbl})
    return b
end

