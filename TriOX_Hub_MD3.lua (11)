local function makeDraggable(frame, handle, onDragEnd, canDragFn)
    handle = handle or frame
    local dragging = false
    local touchStart = nil
    local frameStart = nil
    local activeInput = nil
    local DRAG_THRESHOLD = 8

    handle.InputBegan:Connect(function(input)
        if canDragFn and not canDragFn() then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            touchStart = input.Position
            frameStart = frame.Position
            activeInput = input
            dragging = false

            local endConn
            endConn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    if endConn then endConn:Disconnect() end
                    if dragging then
                        dragging = false
                        hapticFeedback("drag_end")
                        if onDragEnd then onDragEnd(frame) end
                    end
                    activeInput = nil
                    touchStart = nil
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if canDragFn and not canDragFn() then
            if dragging then
                dragging = false
                activeInput = nil
            end
            return
        end
        if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch)
            and activeInput and input == activeInput and touchStart and frameStart then

            local delta = input.Position - touchStart
            if not dragging and delta.Magnitude > DRAG_THRESHOLD then
                dragging = true
                hapticFeedback("drag_start")
            end

            if dragging then
                local viewport = Camera.ViewportSize
                local currentX = frameStart.X.Scale * viewport.X + frameStart.X.Offset + delta.X
                local currentY = frameStart.Y.Scale * viewport.Y + frameStart.Y.Offset + delta.Y

                local frameW = frame.AbsoluteSize.X
                local frameH = frame.AbsoluteSize.Y

                local clampedX = math.clamp(currentX, 8, math.max(8, viewport.X - frameW - 8))
                local clampedY = math.clamp(currentY, 24, math.max(24, viewport.Y - frameH - 8))

                frame.Position = UDim2.new(0, clampedX, 0, clampedY)
            end
        end
    end)
end

