-- ══════════════════════════════════════════════════════════════════════

local UtilsModule = {}

function UtilsModule.LaunchInfiniteYield()
    hapticFeedback("toggle_on")
    showToast("Infinite Yield", "Загрузка скрипта...")
    task.spawn(function()
        local success, err = pcall(function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source"))()
        end)
        if success then
            showToast("Infinite Yield", "Успешно запущен!")
        else
            showToast("Infinite Yield", "Ошибка запуска: " .. tostring(err), true)
        end
    end)
end

function UtilsModule.Rejoin()
    hapticFeedback("danger")
    showToast("Сервер", "Перезаход...")
    task.delay(0.5, function()
        pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
        end)
    end)
end

