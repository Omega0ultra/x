-- Логика свайпа по радужному слайдеру
local function updateHueFromInput(input)
    local trackAbsX = sliderTrack.AbsolutePosition.X
    local trackWidth = sliderTrack.AbsoluteSize.X
    if trackWidth > 0 then
        local relX = math.clamp((input.Position.X - trackAbsX) / trackWidth, 0, 1)
        currentHue = relX
        thumbMask.Position = UDim2.new(relX, 0, 0.5, 0)
        applyLiveTheme(buildThemeFromHue(currentHue, isDarkMode))
        thumbLine.BackgroundColor3 = T.Accent

        if math.abs(relX - lastHueTick) > 0.05 then
            lastHueTick = relX
            hapticFeedback("tick")
        end
    end
end

sliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isSlidingHue = true
        updateHueFromInput(input)
        hapticFeedback("tap")
    end
end)

sliderTrack.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if isSlidingHue then
            isSlidingHue = false
            hapticFeedback("drag_end")
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isSlidingHue and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateHueFromInput(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
