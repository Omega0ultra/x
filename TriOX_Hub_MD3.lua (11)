local function updatePillFade()
    local totalContentHeight = plLayout.AbsoluteContentSize.Y
    local listHeight = pillsList.AbsoluteSize.Y
    local maxPos = math.max(0, totalContentHeight - listHeight)

    if maxPos <= 4 then
        pillFadeGrad.Transparency = NumberSequence.new(0)
        return
    end

    local pos = pillsList.CanvasPosition.Y
    local topFactor = math.clamp(pos / 24, 0, 1)
    local botFactor = math.clamp((maxPos - pos) / 24, 0, 1)

    pillFadeGrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0.00, topFactor),
        NumberSequenceKeypoint.new(0.08, 0.0),
        NumberSequenceKeypoint.new(0.92, 0.0),
        NumberSequenceKeypoint.new(1.00, botFactor)
    })
end

pillsList:GetPropertyChangedSignal("CanvasPosition"):Connect(updatePillFade)

