        if ThemeRegistry.ThemeBarThumb then
            ThemeRegistry.ThemeBarThumb.Parent.Position = UDim2.new(currentHue, 0, 0.5, 0)
        end
    end
    if data.IsDarkMode ~= nil then
        isDarkMode = data.IsDarkMode
    end
    if applyLiveTheme then
        applyLiveTheme(buildThemeFromHue(currentHue, isDarkMode))
    end
    if data.HiddenButtons then
        Config.HiddenButtons = data.HiddenButtons
        applyButtonVisibility()
        for pName, sw in pairs(PillSwitches) do
            if pName ~= "Настройки" then
                local isVis = not (Config.HiddenButtons[pName] == true)
                sw.SetState(isVis, true)
            end
        end
    end
    if data.CustomButtons then
        Config.CustomButtons = data.CustomButtons
        refreshCustomButtonsList()
        if syncCustomPills then syncCustomPills() end
    end
    if updateMenuGeometry then updateMenuGeometry() end
end

