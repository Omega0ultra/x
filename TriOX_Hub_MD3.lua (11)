-- 13. ИСПОЛНИТЕЛЬ СКРИПТОВ
-- ══════════════════════════════════════════════════════════════════════

local function executeScript(source)
    if not source or source:gsub("%s+", "") == "" then return end
    hapticFeedback("toggle_on")
    local fn, err = loadstring(source)
    if not fn then
        showToast("Ошибка синтаксиса", tostring(err), true)
        return
    end
    local success, runErr = pcall(fn)
    if not success then
        showToast("Ошибка выполнения", tostring(runErr), true)
    else
        showToast("Выполнено", "Скрипт запущен успешно")
    end
end

