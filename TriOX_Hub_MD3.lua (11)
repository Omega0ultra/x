applyLiveTheme = function(newTheme)
    T = newTheme
    local dur = 0.22

    if ThemeRegistry.FabClosed then
        tweenProp(ThemeRegistry.FabClosed, dur, {BackgroundColor3 = T.FabBg})
        tweenProp(ThemeRegistry.FabClosedIcon, dur, {ImageColor3 = T.FabIcon})
    end

    if ThemeRegistry.FabOpened then
        tweenProp(ThemeRegistry.FabOpened, dur, {BackgroundColor3 = T.CloseFabBg})
        tweenProp(ThemeRegistry.FabOpenedIcon, dur, {ImageColor3 = T.CloseFabIcon})
    end

    for _, item in ipairs(ThemeRegistry.Pills) do
        tweenProp(item.Pill, dur, {BackgroundColor3 = T.PillBg})
        tweenProp(item.Icon, dur, {ImageColor3 = T.PillText})
        tweenProp(item.Label, dur, {TextColor3 = T.PillText})
    end

    for _, p in ipairs(ThemeRegistry.Panels) do
        tweenProp(p.Panel, dur, {BackgroundColor3 = T.CardBg})
        tweenProp(p.Header, dur, {BackgroundColor3 = T.CardHeader})
        tweenProp(p.Cover, dur, {BackgroundColor3 = T.CardHeader})
        tweenProp(p.Stroke, dur, {Color = T.CardStroke})
        tweenProp(p.Icon, dur, {ImageColor3 = T.Accent})
        tweenProp(p.Title, dur, {TextColor3 = T.CardText})
        tweenProp(p.Close, dur, {BackgroundColor3 = T.ButtonSecondary, ImageColor3 = T.CardText})
    end

    for _, bData in ipairs(ThemeRegistry.Buttons) do
        local btn = bData.Button
        if btn and btn.Parent then
            local targetBg = T.ButtonSecondary
            local targetText = T.ButtonSecondaryText
            if bData.Role == "Primary" then
                targetBg = T.ButtonPrimary
                targetText = T.ButtonPrimaryText
            elseif bData.Role == "Danger" then
                targetBg = T.ButtonDanger
                targetText = T.ButtonDangerText
            end

            tweenProp(btn, dur, {BackgroundColor3 = targetBg})

            if bData.TextLbl and bData.TextLbl.Parent then
                tweenProp(bData.TextLbl, dur, {TextColor3 = targetText})
            elseif btn:IsA("TextButton") or btn:IsA("TextLabel") then
                tweenProp(btn, dur, {TextColor3 = targetText})
            end

            if bData.IconImg and bData.IconImg.Parent then
                tweenProp(bData.IconImg, dur, {ImageColor3 = targetText})
            elseif btn:IsA("ImageButton") or btn:IsA("ImageLabel") then
                tweenProp(btn, dur, {ImageColor3 = (bData.Role == "Danger") and targetText or T.CardText})
            end
        end
    end

    for _, tb in ipairs(ThemeRegistry.Inputs) do
        tweenProp(tb, dur, {
            BackgroundColor3 = T.InputBg,
            TextColor3 = T.CardText,
            PlaceholderColor3 = T.CardTextSub
        })
    end

    if ThemeRegistry.SpecBar then
        tweenProp(ThemeRegistry.SpecBar, dur, {BackgroundColor3 = T.CardBg})
    end
    if ThemeRegistry.SpecBarStroke then
        tweenProp(ThemeRegistry.SpecBarStroke, dur, {Color = T.CardStroke})
    end
    if ThemeRegistry.SpecBarLabel then
        tweenProp(ThemeRegistry.SpecBarLabel, dur, {TextColor3 = T.CardText})
    end

    if ThemeRegistry.ThemeBarStroke then
        tweenProp(ThemeRegistry.ThemeBarStroke, dur, {Color = T.CardStroke})
    end
    if ThemeRegistry.ThemeBarThumb then
        tweenProp(ThemeRegistry.ThemeBarThumb, dur, {BackgroundColor3 = T.Accent})
    end
    if ThemeRegistry.ModeIcon then
        setIcon(ThemeRegistry.ModeIcon, isDarkMode and Icons.Moon or Icons.Sun, Color3.fromRGB(0, 0, 0))
    end

    if tabButtons then
        for key, btn in pairs(tabButtons) do
            local isActive = (key == activePageKey)
            tweenProp(btn, dur, {
                BackgroundColor3 = isActive and T.ButtonPrimary or T.ButtonSecondary,
                TextColor3 = isActive and T.ButtonPrimaryText or T.ButtonSecondaryText
            })
        end
    end

    for _, sw in ipairs(ActiveSwitches) do
        sw.UpdateTheme()
    end
end

