local function setupTouchButton(btn, onClick, tapHaptic)
    btn.Active = true
    btn.AutoButtonColor = false

    local origSize = btn.Size
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            tween(btn, 0.08, {Size = UDim2.new(origSize.X.Scale, origSize.X.Offset - 3, origSize.Y.Scale, origSize.Y.Offset - 2)})
            hapticFeedback(tapHaptic or "tap")
        end
    end)

    local function restore()
        tween(btn, 0.14, {Size = origSize}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end

    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            restore()
        end
    end)

    btn.Activated:Connect(function()
        restore()
        if onClick then onClick() end
    end)
end

local function createButtonWithIcon(parent, iconData, textStr, size, role, onClick, hapticStyle)
    local btn = Instance.new("TextButton")
    btn.Size = size or UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = (role == "Primary") and T.ButtonPrimary or ((role == "Danger") and T.ButtonDanger or T.ButtonSecondary)
    btn.BorderSizePixel = 0
