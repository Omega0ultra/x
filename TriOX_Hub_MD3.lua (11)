    end
    if updateMenuGeometry then updateMenuGeometry() end
end

-- Адаптивная геометрия меню под экран (верхняя и нижняя части)
local isMenuOpen = false

updateMenuGeometry = function()
    local viewport = Camera.ViewportSize
    local fabX = fabContainer.AbsolutePosition.X
    local fabY = fabContainer.AbsolutePosition.Y

    local isTopHalf = (fabY < (viewport.Y / 2))
    local isRightHalf = (fabX > (viewport.X / 2))

    local visibleCount = 0
    for _, item in ipairs(AllSpeedDialPills) do
        if item.Pill and item.Pill.Parent and item.Pill.Visible then
            visibleCount = visibleCount + 1
        end
    end

    local pillItemHeight = 42 -- 36px пилюля + 6px отступ
    local totalContentHeight = math.max(36, visibleCount * pillItemHeight)

    -- Расчет доступного пространства до края экрана
    local maxAvailHeight = isTopHalf
        and math.max(70, viewport.Y - (fabY + 62) - 16)
        or  math.max(70, fabY - 16)

    local listHeight = math.min(totalContentHeight, maxAvailHeight)

    pillsList.Size = UDim2.new(0, 168, 0, listHeight)
    pillsList.CanvasSize = UDim2.new(0, 0, 0, totalContentHeight)

    local xOffset = isRightHalf and -106 or 0
    if isTopHalf then
        -- FAB сверху: меню раскрывается вниз, скроллится сверху вниз
        pillsList.Position = UDim2.new(0, xOffset, 0, 62)
        pillsList.CanvasPosition = Vector2.new(0, 0)
    else
        -- FAB снизу: меню раскрывается вверх, скроллится от FAB вверх
        pillsList.Position = UDim2.new(0, xOffset, 0, -listHeight - 8)
        pillsList.CanvasPosition = Vector2.new(0, math.max(0, totalContentHeight - listHeight))
    end

    pillsList.ScrollingEnabled = (totalContentHeight > listHeight + 2)
    updatePillFade()
end

local function setMenuOpen(open)
    isMenuOpen = open
    if open then
        hapticFeedback("fab_open")
        updateMenuGeometry()
        fabClosed.Visible = false
        fabOpened.Visible = true
        pillsList.Visible = true

        fabOpened.Rotation = -90
        tween(fabOpened, 0.25, {Rotation = 0}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

        for i, item in ipairs(AllSpeedDialPills) do
            if item.Pill.Visible then
                item.Pill.Size = UDim2.new(0, 130, 0, 32)
                item.Pill.BackgroundTransparency = 0.6
                tween(item.Pill, 0.16 + (i * 0.02), {
                    Size = UDim2.new(0, 160, 0, 36),
                    BackgroundTransparency = 0
                }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            end
        end
    else
        hapticFeedback("fab_close")
        for i, item in ipairs(AllSpeedDialPills) do
            if item.Pill.Visible then
                tween(item.Pill, 0.12, {
                    Size = UDim2.new(0, 130, 0, 32),
                    BackgroundTransparency = 0.8
                })
            end
        end
        task.delay(0.12, function()
            if not isMenuOpen then
                fabOpened.Visible = false
                fabClosed.Visible = true
                pillsList.Visible = false
                fabClosed.Size = UDim2.new(0.85, 0, 0.85, 0)
                tween(fabClosed, 0.2, {Size = UDim2.new(1, 0, 1, 0)}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            end
        end)
    end
end

