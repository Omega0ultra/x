            local txt = ""
            if App.Esp.ShowName and App.Esp.ShowDist then txt = string.format("%s\n[%.0f studs]", entry.Name, dist)
            elseif App.Esp.ShowName then txt = entry.Name
            elseif App.Esp.ShowDist then txt = string.format("[%.0f studs]", dist) end

            lbl.Text = txt
            lbl.Parent = bb
            bb.Parent = part
            table.insert(App.Esp.Billboards, {Billboard = bb, Label = lbl, Part = part, BaseName = entry.Name})
        end
    end

    showToast("Подсветка", "Подсвечено: " .. #targets, "Success")

    App.Esp.Heartbeat = RunService.Heartbeat:Connect(function()
        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not root then return end

        for i = #App.Esp.Billboards, 1, -1 do
            local item = App.Esp.Billboards[i]
            if item.Part and item.Part.Parent then
                local d = (root.Position - item.Part.Position).Magnitude
                local txt = ""
                if App.Esp.ShowName and App.Esp.ShowDist then txt = string.format("%s\n[%.0f studs]", item.BaseName, d)
                elseif App.Esp.ShowName then txt = item.BaseName
                elseif App.Esp.ShowDist then txt = string.format("[%.0f studs]", d) end
                item.Label.Text = txt
            else
                if item.Billboard and item.Billboard.Parent then item.Billboard:Destroy() end
                table.remove(App.Esp.Billboards, i)
            end
        end
    end)
end

