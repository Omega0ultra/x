-- Радужная анимация
local rainbowIdx = 1
local transitionSpeed = 3
local rainbowProgress = 0

RunService.Heartbeat:Connect(function(dt)
    if not mainGUI or not mainGUI.Parent then return end
    if App.RainbowGlow then
        rainbowProgress = rainbowProgress + (dt / transitionSpeed)
        if rainbowProgress >= 1 then
            rainbowProgress = 0
            rainbowIdx = (rainbowIdx % #rainbowColors) + 1
        end

        local nextIdx = (rainbowIdx % #rainbowColors) + 1
        local c1 = rainbowColors[rainbowIdx]
        local c2 = rainbowColors[nextIdx]
        local currentColor = c1:Lerp(c2, rainbowProgress)

        titleLabel.TextColor3 = currentColor
        logoBadge.BackgroundColor3 = currentColor:Lerp(theme.Surface, 0.4)
        fabStroke.Color = currentColor
        fabBtn.TextColor3 = currentColor
    end
end)

