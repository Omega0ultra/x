    end
end

function FlyModule.Start()
    if FlyModule.Active then return end
    FlyModule.Active = true
    hapticFeedback("toggle_on")

    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    disableHumanoidStates(char)

    FlyModule.TpWalking = true
    for i = 1, FlyModule.Speed do
        task.spawn(function()
            local hb = RunService.Heartbeat
            local chr = LocalPlayer.Character
            local hum = chr and chr:FindFirstChildOfClass("Humanoid")
            while FlyModule.TpWalking and hb:Wait() and chr and hum and hum.Parent do
                if hum.MoveDirection.Magnitude > 0 then
                    chr:TranslateBy(hum.MoveDirection * FlyModule.Speed)
                end
            end
        end)
    end

    local rootPart = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
    if rootPart then
        local bg = Instance.new("BodyGyro")
        bg.Name = "TriOX_FlyGyro"
        bg.P = 9e4
        bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.cframe = rootPart.CFrame
        bg.Parent = rootPart

        local bv = Instance.new("BodyVelocity")
        bv.Name = "TriOX_FlyVelocity"
        bv.velocity = Vector3.new(0, 0.1, 0)
        bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Parent = rootPart
    end

    if FlyModule.ToggleBtn then
        FlyModule.ToggleBtn.Text = "Остановить"
        tween(FlyModule.ToggleBtn, 0.25, {
            BackgroundColor3 = T.ButtonDanger,
            TextColor3 = T.ButtonDangerText
        })
    end
    showToast("Полёт", "Включен (" .. FlyModule.Speed .. "x)")
end

function FlyModule.Stop()
    if not FlyModule.Active then return end
    FlyModule.Active = false
    FlyModule.TpWalking = false
    hapticFeedback("toggle_off")

    local char = LocalPlayer.Character
    enableHumanoidStates(char)

    if char then
        local rootPart = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
        if rootPart then
