-- Адаптивная геометрия меню под экран
local isMenuOpen = false

local function updateMenuGeometry()
    local viewport = Camera.ViewportSize
    local fabX = fabContainer.AbsolutePosition.X
    local fabY = fabContainer.AbsolutePosition.Y

    local isTopHalf = (fabY < (viewport.Y / 2))
    local isRightHalf = (fabX > (viewport.X / 2))

    local totalHeight = 7 * 42
    local availHeight = isTopHalf and (viewport.Y - fabY - 70) or (fabY - 20)
    local listHeight = math.clamp(availHeight, 150, totalHeight)

    pillsList.Size = UDim2.new(0, 160, 0, listHeight)
    pillsList.CanvasSize = UDim2.new(0, 0, 0, totalHeight)

    local xOffset = isRightHalf and -106 or 0
    if isTopHalf then
        fabOpened.Position = UDim2.new(0, 2, 0, 2)
        pillsList.Position = UDim2.new(0, xOffset, 0, 62)
        plLayout.VerticalAlignment = Enum.VerticalAlignment.Top
    else
        fabOpened.Position = UDim2.new(0, 2, 0, 2)
        pillsList.Position = UDim2.new(0, xOffset, 0, -listHeight - 8)
        plLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    end
end

local function setMenuOpen(open)
    isMenuOpen = open
    if open then
        hapticFeedback("fab_open")
        updateMenuGeometry()
        fabClosed.Visible = false
        fabOpened.Visible = true
        pillsList.Visible = true

        -- Анимация раскрутки ✕ кнопки
        fabOpened.Rotation = -90
        tween(fabOpened, 0.25, {Rotation = 0}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

        -- Плавный каскад пилюль со spring-эффектом
        for i, item in ipairs(ThemeRegistry.Pills) do
            item.Pill.Size = UDim2.new(0, 130, 0, 32)
            item.Pill.BackgroundTransparency = 0.6
            tween(item.Pill, 0.18 + (i * 0.025), {
                Size = UDim2.new(0, 160, 0, 36),
                BackgroundTransparency = 0
            }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        end
    else
        hapticFeedback("fab_close")
        -- Сжатие пилюль перед закрытием
        for i, item in ipairs(ThemeRegistry.Pills) do
            tween(item.Pill, 0.12, {
                Size = UDim2.new(0, 130, 0, 32),
                BackgroundTransparency = 0.8
            })
        end
        task.delay(0.12, function()
            if not isMenuOpen then
                fabOpened.Visible = false
                fabClosed.Visible = true
                pillsList.Visible = false
                -- Пружинный отскок закрытого FAB
                fabClosed.Size = UDim2.new(0.85, 0, 0.85, 0)
                tween(fabClosed, 0.2, {Size = UDim2.new(1, 0, 1, 0)}, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            end
        end)
    end
end

