local Telekinesis = {
    Holding = false,
    Dist = 15
}

function Telekinesis.GiveTool()
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:WaitForChild("Backpack")
    local old = bp:FindFirstChild("Телекинез") or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Телекинез"))
    if old then old:Destroy() end

    local tool = Instance.new("Tool")
    tool.Name = "Телекинез"
    tool.RequiresHandle = true
    tool.CanBeDropped = false

    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(0.5, 0.5, 2.5)
    handle.Color = Color3.fromRGB(208, 188, 255)
    handle.Material = Enum.Material.Neon
    handle.Transparency = 0.3
    handle.CanCollide = false
    handle.Parent = tool

    local targetPart = nil
    local bPos, bGyro, conn = nil, nil, nil

    tool.Equipped:Connect(function(mouse)
        mouse.Button1Down:Connect(function()
            local target = mouse.Target
            if target and not target.Anchored and target.Parent ~= LocalPlayer.Character and not target:IsDescendantOf(LocalPlayer.Character) then
                targetPart = target
                Telekinesis.Holding = true
                hapticFeedback("drag_start")

                bPos = Instance.new("BodyPosition")
                bPos.MaxForce = Vector3.new(1e6, 1e6, 1e6)
                bPos.P = 15000
                bPos.D = 600
                bPos.Position = targetPart.Position
                bPos.Parent = targetPart

                bGyro = Instance.new("BodyGyro")
                bGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
                bGyro.P = 15000
                bGyro.CFrame = targetPart.CFrame
                bGyro.Parent = targetPart

                conn = RunService.RenderStepped:Connect(function()
                    if Telekinesis.Holding and targetPart and bPos and bGyro then
                        local char = LocalPlayer.Character
                        local head = char and char:FindFirstChild("Head")
                        if head then
                            bPos.Position = head.Position + (mouse.Hit.LookVector * Telekinesis.Dist)
                            bGyro.CFrame = mouse.Hit
                        end
                    else
                        if conn then conn:Disconnect(); conn = nil end
                    end
                end)
            end
        end)

        mouse.Button1Up:Connect(function()
            if Telekinesis.Holding then
                hapticFeedback("drag_end")
            end
            Telekinesis.Holding = false
            if conn then conn:Disconnect(); conn = nil end
            if bPos then bPos:Destroy(); bPos = nil end
            if bGyro then bGyro:Destroy(); bGyro = nil end
            targetPart = nil
        end)

        mouse.WheelForward:Connect(function()
            Telekinesis.Dist = math.clamp(Telekinesis.Dist + 4, 5, 120)
            hapticFeedback("tick")
        end)
        mouse.WheelBackward:Connect(function()
            Telekinesis.Dist = math.clamp(Telekinesis.Dist - 4, 5, 120)
            hapticFeedback("tick")
        end)
    end)

    tool.Unequipped:Connect(function()
        Telekinesis.Holding = false
        if conn then conn:Disconnect(); conn = nil end
        if bPos then bPos:Destroy(); bPos = nil end
        if bGyro then bGyro:Destroy(); bGyro = nil end
        targetPart = nil
    end)

    tool.Parent = bp
    hapticFeedback("toggle_on")
    showToast("Телекинез", "Инструмент выдан в инвентарь!")
end

