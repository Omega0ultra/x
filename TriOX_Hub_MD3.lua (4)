local function executeScript(code)
    if not code or code:match("^%s*$") then
        hapticFeedback("danger")
        showToast("Исполнитель", "Поле ввода пусто", true)
        return
    end
    local loadFn = loadstring or (getfenv and getfenv().loadstring)
    if not loadFn then
        hapticFeedback("danger")
        showToast("Исполнитель", "loadstring не поддерживается", true)
        return
    end
    local fn, err = loadFn(code)
    if fn then
        local success, runErr = pcall(fn)
        if success then
            hapticFeedback("toggle_on")
            showToast("Исполнитель", "Скрипт выполнен!")
        else
            hapticFeedback("danger")
            showToast("Ошибка", tostring(runErr), true)
        end
    else
        hapticFeedback("danger")
        showToast("Синтаксис", tostring(err), true)
    end
end

