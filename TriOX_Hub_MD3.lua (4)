local HapticProfiles = {
    tap = { ms = 15, motor = 0.35 },
    toggle_on = { ms = 25, motor = 0.65 },
    toggle_off = { ms = 20, motor = 0.40 },
    drag_start = { ms = 30, motor = 0.70 },
    drag_end = { ms = 20, motor = 0.50 },
    fab_open = { ms = 35, motor = 0.75 },
    fab_close = { ms = 18, motor = 0.40 },
    theme_change = { ms = 40, motor = 0.80 },
    danger = { ms = 45, motor = 0.85 },
    tick = { ms = 10, motor = 0.25 }
}

local function hapticFeedback(profileName)
    local prof = HapticProfiles[profileName] or HapticProfiles.tap
    local ms = prof.ms
    local intensity = prof.motor

    -- Экзекуторы на Android (Delta, Fluxus, etc.)
    pcall(function()
        if type(vibrate) == "function" then vibrate(ms); return end
        if type(vibration) == "function" then vibration(ms); return end
        if type(haptic) == "function" then haptic(ms); return end
    end)

    -- Roblox HapticService (геймпад / мобильный контроллер)
    pcall(function()
        for _, uType in ipairs({Enum.UserInputType.Gamepad1, Enum.UserInputType.Gamepad2}) do
            if HapticService:IsMotorSupported(uType, Enum.VibrationMotor.Small) then
                HapticService:SetMotor(uType, Enum.VibrationMotor.Small, intensity)
                task.delay(ms / 1000, function()
                    pcall(function() HapticService:SetMotor(uType, Enum.VibrationMotor.Small, 0) end)
                end)
            end
        end
    end)
end

local function tween(inst, dur, props, style, dir)
    local anim = TweenService:Create(
        inst,
        TweenInfo.new(dur or 0.25, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out),
        props
    )
    anim:Play()
    return anim
end

local function tweenProp(inst, dur, props)
    if inst and inst.Parent then
        pcall(function()
            TweenService:Create(
                inst,
                TweenInfo.new(dur or 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
                props
            ):Play()
        end)
    end
end

