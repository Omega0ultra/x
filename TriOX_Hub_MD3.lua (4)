local EspModule = {
    Active = false,
    Billboards = {},
    Query = "Players",
    Heartbeat = nil
}

function EspModule.Clear()
    EspModule.Active = false
    hapticFeedback("danger")
    if EspModule.Heartbeat then EspModule.Heartbeat:Disconnect(); EspModule.Heartbeat = nil end
    for _, item in ipairs(EspModule.Billboards) do
        if item.Billboard and item.Billboard.Parent then item.Billboard:Destroy() end
    end
    table.clear(EspModule.Billboards)
end

function EspModule.Apply()
    EspModule.Clear()
    EspModule.Active = true
    hapticFeedback("toggle_on")

    local targets = {}
    local q = EspModule.Query:lower():gsub("%s+", "")

    if q == "players" or q == "player" or q == "" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local root = p.Character:FindFirstChild("HumanoidRootPart") or p.Character:FindFirstChild("Torso")
                if root then table.insert(targets, {Part = root, Name = p.DisplayName, Color = Color3.fromRGB(130, 220, 255)}) end
            end
        end
    elseif q == "tools" or q == "items" or q == "item" then
        for _, inst in ipairs(Workspace:GetDescendants()) do
            if inst:IsA("Tool") and inst:FindFirstChild("Handle") then
                table.insert(targets, {Part = inst.Handle, Name = inst.Name, Color = Color3.fromRGB(255, 215, 120)})
            end
        end
    else
        for _, inst in ipairs(Workspace:GetDescendants()) do
            if inst:IsA("BasePart") and inst.Name:lower():find(q) then
                table.insert(targets, {Part = inst, Name = inst.Name, Color = Color3.fromRGB(210, 180, 255)})
            end
        end
    end

    for _, obj in ipairs(targets) do
        local bb = Instance.new("BillboardGui")
        bb.Name = "TriOX_ESP"
        bb.Adornee = obj.Part
        bb.Size = UDim2.new(0, 140, 0, 36)
        bb.StudsOffset = Vector3.new(0, 2.5, 0)
        bb.AlwaysOnTop = true
        bb.Active = false
        bb.Parent = obj.Part

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 11
        lbl.TextColor3 = obj.Color
        lbl.TextStrokeTransparency = 0.4
        lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        lbl.Text = obj.Name
        lbl.Active = false
        lbl.Parent = bb

        table.insert(EspModule.Billboards, {Billboard = bb, Label = lbl, Part = obj.Part, Name = obj.Name})
    end

    showToast("Подсветка", "Найдено объектов: " .. #targets)

    EspModule.Heartbeat = RunService.Heartbeat:Connect(function()
        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not root then return end

        for i = #EspModule.Billboards, 1, -1 do
            local item = EspModule.Billboards[i]
            if item.Part and item.Part.Parent then
                local dist = (root.Position - item.Part.Position).Magnitude
                item.Label.Text = string.format("%s\n[%.0f studs]", item.Name, dist)
            else
                if item.Billboard and item.Billboard.Parent then item.Billboard:Destroy() end
                table.remove(EspModule.Billboards, i)
            end
        end
    end)
end

